# Copy to .env and fill in. Do not commit .env.
# Loaded automatically on server/mcp start (OS env still wins if set).

GOOGLE_MAPS_API_KEY=

# OpenAI-compatible LLM (Colab+Cloudflare / Ollama / other). Protocol shape only — not OpenAI models.
# Empty LLM_BASE_URL disables /api/v1/llm/* (clients use template fallback).
# Colab + Cloudflare: see deployments/cloudflare/CLOUDFLARE.md
#   LLM_BASE_URL=https://xxxx.trycloudflare.com/v1
#   LLM_MODEL=navgo-gemma
#   LLM_API_KEY=<same as Colab LLM_API_KEY>
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma2:2b
LLM_API_KEY=

# Colab / tunnel generate can exceed 60s — raise write timeout for /api/v1/llm/*.
SERVER_WRITE_TIMEOUT_SECONDS=300
