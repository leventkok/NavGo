# Copy to .env and fill in. Do not commit .env.
# Loaded automatically on server/mcp start (OS env still wins if set).

GOOGLE_MAPS_API_KEY=

# JWT / auth
JWT_SECRET=change-me-in-production
JWT_EXPIRATION_HOURS=8
REQUIRE_AUTH_HANDSHAKE=true
REQUIRE_BLENDED_SENSITIVE=true
APP_ENV=production

# LLM kill switch (also Redis key navgo:llm_kill_switch=1)
LLM_KILL_SWITCH=false

# OpenAI-compatible LLM (Colab+Cloudflare / Ollama / other). Protocol shape only — not OpenAI models.
# Empty LLM_BASE_URL disables /api/v1/llm/* (clients use template fallback).
# Colab + Cloudflare: see deployments/cloudflare/CLOUDFLARE.md
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_MODEL=gemma2:2b
LLM_API_KEY=

# Colab / tunnel generate can exceed 60s — raise write timeout for /api/v1/llm/*.
SERVER_WRITE_TIMEOUT_SECONDS=300

# MCP (cmd/mcp)
MCP_USER_ID=
MCP_SERVICE_TOKEN=
MCP_REQUIRE_TOKEN=false
MCP_EXPECTED_TOKEN=

# Optional magic-link SMTP (without SMTP, dev_token returned when APP_ENV!=production)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
